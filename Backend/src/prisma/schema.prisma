generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}  

model Booking {
  id             String      @id @default(uuid())
  origin         String      @db.Char(3)
  destination    String      @db.Char(3)
  cabinClass     String
  duffelOfferId  String
  airlineName    String?
  totalAmount    Decimal     @db.Decimal(10, 2)
  currency       String      @db.Char(3) @default("USD")
  takeoffTime    DateTime    @db.Timestamptz
  arrivalTime    DateTime    @db.Timestamptz
  phone          String
  email          String?
  status         String      @default("pending")
  createdAt      DateTime    @default(now()) @db.Timestamptz

  passengers     Passenger[]

  @@index([email])
  @@map("bookings")
}

model Passenger {
  id         String   @id @default(uuid())
  bookingId  String
  type       String
  fullName   String
  age        Int?
  position   Int

  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@map("passengers")
}